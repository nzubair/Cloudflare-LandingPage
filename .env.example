# Cloudflare API Token (Workers edit permission required)
# Used by GitHub Actions for deployment (set as repository secret)
CLOUDFLARE_API_TOKEN=

# KV Namespace IDs — get these after running:
#   npx wrangler kv:namespace create CONFIG
#   npx wrangler kv:namespace create CONFIG --preview
#   npx wrangler kv:namespace create IMAGES
#   npx wrangler kv:namespace create IMAGES --preview
CONFIG_KV_NAMESPACE_ID=
CONFIG_KV_PREVIEW_NAMESPACE_ID=
IMAGES_KV_NAMESPACE_ID=
IMAGES_KV_PREVIEW_NAMESPACE_ID=
